*_final.*
clip_*.mkv
clip_*.mp4
*.y4m
*.ivf

# --- Data folders: keep structure with .gitkeep only ---
# Ignore user-provided inputs and produced outputs, but keep the directory and .gitkeep
Data/testbench_small/*
!Data/testbench_small/.gitkeep
Data/testbench_small_output/*
!Data/testbench_small_output/.gitkeep

# --- OS metadata (Linux/mac/Windows) ---
*.swp
*.swo
*~
